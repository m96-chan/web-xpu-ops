{
  "name": "web-xpu-ops",
  "version": "0.1.0",
  "description": "Web primitive layer implementations for xPU: one reference per op, one implementation per backend, and tests that hold them together.",
  "type": "module",
  "license": "MIT",
  "author": "Yusuke Harada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m96-chan/web-xpu-ops.git"
  },
  "homepage": "https://github.com/m96-chan/web-xpu-ops#readme",
  "bugs": {
    "url": "https://github.com/m96-chan/web-xpu-ops/issues"
  },
  "keywords": [
    "webgpu",
    "wgsl",
    "webnn",
    "gpu",
    "npu",
    "kernel",
    "shader",
    "tensor",
    "inference",
    "machine-learning",
    "browser"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./ops/*": {
      "types": "./dist/ops/*/index.d.ts",
      "default": "./dist/ops/*/index.js"
    },
    "./ops/*.wgsl": "./dist/ops/*.wgsl",
    "./llm/tokenizer": {
      "types": "./dist/llm/tokenizer.d.ts",
      "default": "./dist/llm/tokenizer.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/assets.mjs",
    "lint": "tsc --noEmit && tsc -p examples/llm-demo/tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:file": "vitest run",
    "prepublishOnly": "npm run build",
    "demo:build": "node examples/llm-demo/build.mjs",
    "demo:serve": "node examples/llm-demo/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "webgpu": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
