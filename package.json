{
  "name": "web-xpu-ops",
  "version": "0.3.0",
  "description": "WGSL compute kernels for WebGPU, one reference implementation each - and the diffusion, video, vocoder and LLM models built from them, running in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Yusuke Harada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m96-chan/web-xpu-ops.git"
  },
  "homepage": "https://github.com/m96-chan/web-xpu-ops#readme",
  "bugs": {
    "url": "https://github.com/m96-chan/web-xpu-ops/issues"
  },
  "keywords": [
    "webgpu",
    "wgsl",
    "compute-shader",
    "shader",
    "kernel",
    "gpu",
    "browser",
    "tensor",
    "inference",
    "machine-learning",
    "deep-learning",
    "neural-network",
    "on-device",
    "transformers",
    "attention",
    "flash-attention",
    "quantization",
    "int8",
    "stft",
    "mel",
    "diffusion",
    "text-to-image",
    "image-generation",
    "video-generation",
    "llm",
    "vocoder",
    "text-to-speech",
    "audio"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./ops/*": {
      "types": "./dist/ops/*/index.d.ts",
      "default": "./dist/ops/*/index.js"
    },
    "./ops/*.wgsl": "./dist/ops/*.wgsl",
    "./llm/tokenizer": {
      "types": "./dist/llm/tokenizer.d.ts",
      "default": "./dist/llm/tokenizer.js"
    },
    "./llm/tokenizer-bpe": {
      "types": "./dist/llm/tokenizer-bpe.d.ts",
      "default": "./dist/llm/tokenizer-bpe.js"
    },
    "./llm/kv-cache": {
      "types": "./dist/llm/kv-cache.d.ts",
      "default": "./dist/llm/kv-cache.js"
    },
    "./llm/reshape": {
      "types": "./dist/llm/reshape.d.ts",
      "default": "./dist/llm/reshape.js"
    },
    "./llm/sampler": {
      "types": "./dist/llm/sampler.d.ts",
      "default": "./dist/llm/sampler.js"
    },
    "./llm/engine": {
      "types": "./dist/llm/engine-index.d.ts",
      "default": "./dist/llm/engine-index.js"
    },
    "./harness": {
      "types": "./dist/harness/api.d.ts",
      "default": "./dist/harness/api.js"
    },
    "./models/anima": {
      "types": "./dist/models/anima/index.d.ts",
      "default": "./dist/models/anima/index.js"
    },
    "./models/anima/kernels": {
      "types": "./dist/models/anima/kernels.d.ts",
      "default": "./dist/models/anima/kernels.js"
    },
    "./models/anima/fetch-weights": {
      "types": "./dist/models/anima/fetch-weights.d.ts",
      "default": "./dist/models/anima/fetch-weights.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-models.json && node scripts/assets.mjs",
    "lint": "tsc --noEmit && for t in examples/*/tsconfig.json; do echo \"  $t\" && npx tsc -p \"$t\" --noEmit || exit 1; done",
    "test": "node scripts/test.mjs",
    "test:file": "vitest run",
    "prepack": "npm run build",
    "demo:build": "node examples/llm-demo/build.mjs",
    "demo:serve": "node examples/llm-demo/server.mjs",
    "zimage:build": "node examples/zimage-web/build.mjs",
    "zimage:serve": "node examples/zimage-web/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "webgpu": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
