# Z-Image VAE: the decoder weights are 190 MB and the 256px fixture is only
# useful once the GPU path exists — both are regenerated by
# examples/zimage-vae/tools/gen_latent.py from Tongyi-MAI/Z-Image. The 64px
# fixture is committed because the test needs a latent and a reference decode.
examples/zimage-vae/fixtures/
examples/zimage-vae/fixtures-small/decoder.bin
examples/zimage-vae/fixtures-small/decoded.png
examples/zimage-vae/fixtures-tiny/decoder.bin
examples/zimage-vae/fixtures-tiny/decoded.png

# Qwen BPE vocabulary: 5.7 MB, exported by llm/tools/gen_bpe_fixtures.py
# from the checkpoint. The fixtures beside it are committed; this is not.
llm/data/*.bpe-vocab.json

# Workflow subagents get their own worktrees here; they are throwaway.
.claude/worktrees/
